{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"installCommand": "npm install",
	"buildCommand": "npm run build",
	"outputDirectory": "build",
	"trailingSlash": true,
	"rewrites": [
		{ "source": "/((?!assets/|rss\\.xml|sitemap\\.xml|robots\\.txt|favicon\\.ico).*)", "destination": "/index.html" }
	]
}
