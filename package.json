{
  "name": "routerkit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "prebuild": "rm -rf build/",
    "build": "react-router build",
    "preview": "react-router-serve build/server/index.js",
    "deploy": "pnpm run build && wrangler deploy",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "highlight.js": "^11.11.1",
    "isbot": "^5",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "minisearch": "^7.2.0",
    "photoswipe": "^5.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "wrangler": "^4.118.0"
  }
}