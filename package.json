{
  "name": "yuln-blog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "optimize-images": "node scripts/optimize-images.js",
    "build": "node scripts/optimize-images.js && tsc --noEmit && vite build && node scripts/generate-rss.js && node scripts/generate-sitemap.js",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "minisearch": "^7.2.0",
    "photoswipe": "^5.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "sharp": "^0.35.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
